# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# NUNCA commite o arquivo ".env" real (ele fica no .gitignore).

# Porta em que o servidor Express vai escutar
PORT=3001

# Ambiente de execucao: development | production | test
NODE_ENV=development

# Origens permitidas pelo CORS, separadas por virgula (sem espaco apos a virgula)
CORS_ORIGIN=http://localhost:5173,https://sitevoltic.vercel.app

# Chave usada para proteger a rota GET /api/submissions (?key=...)
# Gere uma chave aleatoria forte antes de colocar em producao.
API_KEY=gerar-uma-chave-aleatoria-aqui

# Caminho do arquivo do banco SQLite (relativo a pasta server/)
DATABASE_PATH=./data/voltic.db

# Limite de requisicoes por IP (janela de 15 minutos) para todas as rotas /api
RATE_LIMIT_GLOBAL=100

# Limite de requisicoes por IP (janela de 10 minutos) para os formularios (contact, careers, quote)
RATE_LIMIT_FORM=5

# Nivel de log do pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
